# ============================================================
# Apache Airflow local environment
# ============================================================

# Airflow container user ID
AIRFLOW_UID=50000

# Project directory mounted inside the Airflow containers
AIRFLOW_PROJ_DIR=.

# Optional Airflow image override
AIRFLOW_IMAGE_NAME=alzheimers-airflow:3.3.0

# ============================================================
# Security
# ============================================================

# Generate your own Fernet key.
# Never copy a real project secret into this example file.
FERNET_KEY=REPLACE_WITH_YOUR_FERNET_KEY

# Generate your own random JWT secret.
AIRFLOW__API_AUTH__JWT_SECRET=REPLACE_WITH_YOUR_RANDOM_SECRET

# ============================================================
# Local Airflow administrator
# ============================================================

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME

# No additional packages are required at container startup.
_PIP_ADDITIONAL_REQUIREMENTS=

