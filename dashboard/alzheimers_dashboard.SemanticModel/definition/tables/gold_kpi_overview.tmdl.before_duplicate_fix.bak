table gold_kpi_overview
	lineageTag: 95fc0f52-afee-4097-beb2-fef1f0b50e78

	measure 'Total Patients' = MAX('gold_kpi_overview'[total_patients])
		formatString: #,0
		lineageTag: bde34c6b-de73-4c87-8df3-5c4751cf8c75

	measure 'Diagnosed Patients' = MAX('gold_kpi_overview'[diagnosed_patients])
		formatString: #,0
		lineageTag: 0b74664e-c6cf-4cab-9dd8-65df3261bc86

	measure 'Not Diagnosed Patients' = MAX('gold_kpi_overview'[not_diagnosed_patients])
		formatString: #,0
		lineageTag: 5db28581-99d3-4a15-8366-515395ef8409

	measure 'Diagnosis Rate' = DIVIDE([Diagnosed Patients], [Total Patients])
		formatString: 0.00%
		lineageTag: 80e16e6d-e5dc-494c-9fc0-986d6df17067

	measure 'Average Age' = MAX('gold_kpi_overview'[average_age])
